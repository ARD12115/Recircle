# ReCircle Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Application
APP_ENV=dev
DEMO_MODE=true

# Database
# SQLite for local dev (default)
DATABASE_URL=sqlite:///./recircle.db
# Postgres for production (uncomment and configure)
# DATABASE_URL=postgresql://recircle:recircle@localhost:5432/recircle

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ACCESS_MINUTES=15

# CORS - exact frontend origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model
MODEL_PATH=./app/data/weights/model.pt
MODEL_CONFIG_PATH=./app/data/weights/model_config.json
CONFIDENCE_THRESHOLD=0.60

# Upload & Rate Limits
MAX_UPLOAD_MB=5

# LLM Primary (NVIDIA NIM - OpenAI compatible)
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=nvidia/nemotron-3-ultra
LLM_PRIMARY_API_KEY=your-llm-primary-api-key-here
LLM_PRIMARY_BASE_URL=https://integrate.api.nvidia.com/v1

# LLM Fallback (NVIDIA NIM - OpenAI compatible)
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
LLM_FALLBACK_API_KEY=your-llm-fallback-api-key-here
LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1

# LLM Timeout
LLM_TIMEOUT_SECONDS=60

# Rate Limits
RATE_LIMIT_PER_MIN=15

# Frontend (public, no secrets)
VITE_API_BASE_URL=http://localhost:8000